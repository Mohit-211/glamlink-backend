# Dependencies
node_modules/

# Environment and secrets (only the example is committed)
.env
.env.*
!.env.example

# Runtime files: uploads and logs live in ./storage (see src/core/config/paths.js).
# public/uploads and logs are the old locations, still present on existing servers.
/storage/
/public/uploads/
/logs/

# Database dumps and local data: production data must never be committed.
*.sql
*.sql.gz
*.dump
!src/core/db/seeders/dumps/*.sql
*.sqlite
*.sqlite3

# Logs and process manager files
*.log
npm-debug.log*
.pm2/
*.pid
*.pid.lock

# Tests and coverage
coverage/
.nyc_output/

# Build output
dist/
build/

# Temporary files
tmp/
temp/
*.tmp

# Editors and OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
