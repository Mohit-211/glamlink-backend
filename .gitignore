# Dependencies
node_modules/

# Environment and secrets (only the example is committed)
.env
.env.*
!.env.example

# Runtime files live outside the repo (see src/core/config/paths.js). These are the old in-repo
# locations, still present on existing servers, plus a guard in case STORAGE_DIR points inside the repo.
/storage/
/public/uploads/
/logs/

# Database dumps and local data: production data must never be committed.
*.sql
*.sql.gz
*.dump
!src/core/db/seeds/*.sql
!src/core/db/schema/*.sql
*.sqlite
*.sqlite3

# Logs and process manager files
*.log
npm-debug.log*
.pm2/
*.pid
*.pid.lock

# Tests and coverage
coverage/
.nyc_output/

# Build output
dist/
build/

# Temporary files
tmp/
temp/
*.tmp

# Editors and OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
