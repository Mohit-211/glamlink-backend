{
  "name": "glamlink-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Glamlink API: website (journal, directory, Access card, podcasts, shop), mobile app and CRM backend",
  "main": "index.js",
  "author": "GLAMLINK",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "pm2 start ecosystem.config.json --no-daemon",
    "staging": "pm2 start ecosystem.staging-config.json --no-daemon",
    "dev": "node --watch index.js",
    "auth": "node scripts/create-super-admin.js",
    "migrate": "node src/core/db/migrate.js up",
    "migrate:status": "node src/core/db/migrate.js status",
    "migrate:down": "node src/core/db/migrate.js down",
    "seed": "node src/core/db/seed.js",
    "lint": "oxlint && node scripts/check-boundaries.js",
    "lint:fix": "oxlint --fix",
    "check:routes": "node scripts/route-table.js",
    "check:models": "node scripts/model-table.js",
    "check:boundaries": "node scripts/check-boundaries.js",
    "check:contract": "node scripts/contract-check.js compare",
    "test": "node --test --test-concurrency=1 --test-global-setup=test/setup.js \"test/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.1",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "stripe": "^12.18.0"
  },
  "devDependencies": {
    "oxlint": "^1.88.0"
  }
}
