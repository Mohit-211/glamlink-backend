# Copy to .env and fill in. Every variable the code reads is listed here; values are placeholders only.
# Never commit a real .env. Quote any value containing # (e.g. PASSWORD="ab#cd"): Node treats an unquoted #
# as the start of a comment.

# ---------------------------------------------------------------- App
APP_NAME=glamlink
# development | production | test
NODE_ENV=development
PORT=5000
# Public base URL; uploaded file URLs are built from it
API_BASE_URL=http://127.0.0.1:5000
# The website; email links (verify email, reset password) point at its pages
WEBSITE_URL=https://glamlink.net
# Comma-separated CORS origins
ACCESSDOMAINS=http://localhost:3000,http://localhost:3001
DEFAULT_TIMEZONE=UTC
DEFAULT_API_DATA_LIMIT=15
STORY_VALIDATION_TIME_SPAN_HOURS=24

# Runtime files live outside the repo: uploads in <STORAGE_DIR>/uploads, logs in <STORAGE_DIR>/logs.
# Defaults to a `storage` folder next to the repo (/var/www/backend -> /var/www/storage).
# STORAGE_DIR=/var/www/storage
# UPLOAD_MAX_MB=50

# ---------------------------------------------------------------- Database (MariaDB 10.11 in production)
CENTRAL_MYSQL_HOST=127.0.0.1
CENTRAL_MYSQL_PORT=3306
CENTRAL_MYSQL_DB=glamlink
CENTRAL_MYSQL_USER=glamlink
CENTRAL_MYSQL_PASSWORD=change-me

# ---------------------------------------------------------------- Auth
# Must be a hex string (admin tokens use the hex-decoded value): openssl rand -hex 32
JWT_SECRET=replace-with-64-hex-characters
# Sign-in sessions: short-lived access tokens, refresh tokens that rotate on every use
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Role ids from the roles table
SUP_ADM_ROLE_ID=1
USR_ROLE_ID=6
# Professional
PROFESSIONAL_ROLE_ID=7
BRND_ROLE_ID=8
ADM_DEPT_ID=1

# Used by `npm run auth` to create the first Super Admin
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me

# Placeholder identity written over deleted accounts
DELETED_EMAIL=deleted@example.com
DELETED_NAME=Deleted User

# Cloudflare Turnstile (bot check on registration). When set, sign-up requires a valid turnstile_token.
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------- Email (SMTP; the transport uses TLS, so port 465)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com
# smtp sends mail; log only writes it to the log (use log locally: a production copy has real addresses)
MAIL_TRANSPORT=smtp

# ---------------------------------------------------------------- Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET_INTENT_CHARGE=whsec_xxx
STRIPE_WEBHOOK_SECRET_CUSTOMER_INVOICE_PRICE=whsec_xxx
# Access card prices
STRIPE_GLAMLINK_SETUP_PRICE_ID=price_xxx
STRIPE_GLAMLINK_MONTHLY_PRICE_ID=price_xxx
STRIPE_SHIPPING_PRICE_ID=price_xxx
# Optional regional accounts for specific payment methods
# STRIPE_PUBLISHABLE_KEY_MY= / STRIPE_SECRET_KEY_MY=          (grabpay, fpx)
# STRIPE_PUBLISHABLE_KEY_AU= / STRIPE_SECRET_KEY_AU=          (au_becs_debit)
# STRIPE_PUBLISHABLE_KEY_MX= / STRIPE_SECRET_KEY_MX=          (oxxo)
# STRIPE_PUBLISHABLE_KEY_WECHAT= / STRIPE_SECRET_KEY_WECHAT=  (wechat_pay)
# STRIPE_PUBLISHABLE_KEY_UK= / STRIPE_SECRET_KEY_UK=          (paypal)

# ---------------------------------------------------------------- Shipping and tax
SHIPPO_API_KEY=
NUMERAL_API_KEY=
NUMERAL_BASE_URL=

# ---------------------------------------------------------------- Google
GOOGLE_API_KEY=
GOOGLE_PLACE_API_KEY=
GOOGLE_PLACE_API_URL=

# ---------------------------------------------------------------- AI (skin analysis)
OPENAI_API_KEY=
FACEPP_API_KEY=
FACEPP_API_SECRET=

# ---------------------------------------------------------------- Firebase (push notifications, chat)
# Defaults to src/config/serviceAccountKey.json, where the server keeps the real key.
# FIREBASE_KEY_FILE=
