# Copy to .env and fill in. Every variable the code reads is listed here; values are placeholders only.
# Never commit a real .env.

# ---------------------------------------------------------------- App
APP_NAME=glamlink
NODE_ENV=development                 # development | production | test
PORT=5000
API_BASE_URL=http://127.0.0.1:5000   # public base URL; uploaded file URLs are built from it
ACCESSDOMAINS=http://localhost:3000,http://localhost:3001   # comma-separated CORS origins
DEFAULT_TIMEZONE=UTC
DEFAULT_API_DATA_LIMIT=15
STORY_VALIDATION_TIME_SPAN_HOURS=24

# Runtime files. Uploads go to <STORAGE_DIR>/uploads and logs to <STORAGE_DIR>/logs.
# STORAGE_DIR=./storage
# UPLOAD_MAX_MB=50

# ---------------------------------------------------------------- Database (MariaDB 10.11 in production)
CENTRAL_MYSQL_HOST=127.0.0.1
CENTRAL_MYSQL_PORT=3306
CENTRAL_MYSQL_DB=glamlink
CENTRAL_MYSQL_USER=glamlink
CENTRAL_MYSQL_PASSWORD=change-me

# ---------------------------------------------------------------- Auth
# Must be a hex string (admin tokens use the hex-decoded value): openssl rand -hex 32
JWT_SECRET=replace-with-64-hex-characters
JWT_ACCESS_EXPIRATION_DAYS=7

# Role ids from the roles table
SUP_ADM_ROLE_ID=1
USR_ROLE_ID=6
CLLR_ROLE_ID=7                       # professional
BRND_ROLE_ID=8
ADM_DEPT_ID=1

# Used by `npm run auth` to create the first Super Admin
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me

# Placeholder identity written over deleted accounts
DELETED_EMAIL=deleted@example.com
DELETED_NAME=Deleted User

# Cloudflare Turnstile (bot check on registration)
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------- Email (SMTP; the transport uses TLS, so port 465)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com

# ---------------------------------------------------------------- Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET_INTENT_CHARGE=whsec_xxx
STRIPE_WEBHOOK_SECRET_CUSTOMER_INVOICE_PRICE=whsec_xxx
# Access card prices
STRIPE_GLAMLINK_SETUP_PRICE_ID=price_xxx
STRIPE_GLAMLINK_MONTHLY_PRICE_ID=price_xxx
STRIPE_SHIPPING_PRICE_ID=price_xxx
# Optional regional accounts for specific payment methods
# STRIPE_PUBLISHABLE_KEY_MY= / STRIPE_SECRET_KEY_MY=          (grabpay, fpx)
# STRIPE_PUBLISHABLE_KEY_AU= / STRIPE_SECRET_KEY_AU=          (au_becs_debit)
# STRIPE_PUBLISHABLE_KEY_MX= / STRIPE_SECRET_KEY_MX=          (oxxo)
# STRIPE_PUBLISHABLE_KEY_WECHAT= / STRIPE_SECRET_KEY_WECHAT=  (wechat_pay)
# STRIPE_PUBLISHABLE_KEY_UK= / STRIPE_SECRET_KEY_UK=          (paypal)

# ---------------------------------------------------------------- Shipping and tax
SHIPPO_API_KEY=
NUMERAL_API_KEY=
NUMERAL_BASE_URL=

# ---------------------------------------------------------------- Google
GOOGLE_API_KEY=
GOOGLE_PLACE_API_KEY=
GOOGLE_PLACE_API_URL=

# ---------------------------------------------------------------- AI (skin analysis)
OPENAI_API_KEY=
FACEPP_API_KEY=
FACEPP_API_SECRET=

# ---------------------------------------------------------------- Firebase (push notifications, chat)
# Defaults to src/config/serviceAccountKey.json, where the server keeps the real key.
# FIREBASE_KEY_FILE=
