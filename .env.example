# The settings the API needs for glamlink.net. Copy to .env and fill in the empty values, then check with
# `npm run check:server -- --online`. Never commit a real .env. Write values plainly: quote one only when it holds a
# # (PASSWORD="ab#cd"), and only with straight quotes; Node keeps curly ones as part of the value.
#
# For local development instead: NODE_ENV=development, PORT=5050, API_BASE_URL=http://localhost:5050,
# ACCESSDOMAINS=http://localhost:3000, JOBS_ENABLED=false, MAIL_TRANSPORT=log, and Stripe and Shippo test keys.

# ---------------------------------------------------------------- App
APP_NAME=glamlink
NODE_ENV=production
PORT=5500
API_BASE_URL=https://api.glamlink.net
WEBSITE_URL=https://glamlink.net
ADMIN_URL=https://admin.glamlink.net
# The origins whose pages may call the API
ACCESSDOMAINS=https://glamlink.net,https://www.glamlink.net,https://admin.glamlink.net,https://test.glamlink.net
JOBS_ENABLED=true

# ---------------------------------------------------------------- The website's cache refresh
# The secret is the website's REVALIDATE_SECRET too (openssl rand -hex 32)
WEBSITE_REFRESH_URL=https://glamlink.net/api/revalidate
WEBSITE_REFRESH_SECRET=

# ---------------------------------------------------------------- Database
CENTRAL_MYSQL_HOST=127.0.0.1
CENTRAL_MYSQL_PORT=3306
CENTRAL_MYSQL_DB=glamlinkdb
CENTRAL_MYSQL_USER=
CENTRAL_MYSQL_PASSWORD=

# ---------------------------------------------------------------- Sign-in
# openssl rand -hex 32 (at least 64 hex characters). A new one signs everyone out.
JWT_SECRET=

# ---------------------------------------------------------------- Role ids (the roles table)
SUP_ADM_ROLE_ID=1
USR_ROLE_ID=6
PROFESSIONAL_ROLE_ID=7
BRND_ROLE_ID=8
ADM_DEPT_ID=1

# ---------------------------------------------------------------- What a deleted account's email and name become
DELETED_EMAIL=deleted@deleted.com
DELETED_NAME=Deleted User

# ---------------------------------------------------------------- Email (SMTP over TLS)
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# ---------------------------------------------------------------- Sign-up bot check
# Cloudflare > Turnstile > the Glamlink widget > Secret key (the website has its site key)
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------- Stripe (live)
# Stripe > Developers > API keys, with Test mode off: pk_live_… and sk_live_… in place of these placeholders (the
# API doesn't start with no key at all)
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
# Written by `npm run stripe:webhook`, which makes the webhook endpoint
STRIPE_WEBHOOK_SECRET_INTENT_CHARGE=whsec_xxx

# ---------------------------------------------------------------- Keychain shipping (Shippo)
# Shippo > Settings > API > Live Token
SHIPPO_API_KEY=
# The secret the Shippo webhook URL ends with: openssl rand -hex 24
SHIPPO_WEBHOOK_TOKEN=
# Where keychains ship from: plain text, the state as its 2-letter code (NV)
SHIP_FROM_NAME=
SHIP_FROM_COMPANY=Glamlink
SHIP_FROM_STREET1=
SHIP_FROM_STREET2=
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_ZIP=
SHIP_FROM_COUNTRY=US
SHIP_FROM_PHONE=
SHIP_FROM_EMAIL=

# ---------------------------------------------------------------- Google Cloud > APIs & Services > Credentials
# Server key: Geocoding API, Places API (New), Routes API; restricted to the server's IP
GOOGLE_API_KEY=
# YouTube Data API v3 key, restricted to the server's IP: the Watch videos' imports
YOUTUBE_API_KEY=

# Read by the code but not needed for the website (defaults in src/core/config/config.js):
# - the mobile app: FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY, FIREBASE_DATABASE_URL,
#   OPENAI_API_KEY, FACEPP_API_KEY, FACEPP_API_SECRET, NUMERAL_API_KEY, NUMERAL_BASE_URL, GOOGLE_PLACE_API_KEY,
#   GOOGLE_PLACE_API_URL, DEFAULT_TIMEZONE (UTC), STORY_VALIDATION_TIME_SPAN_HOURS
# - the old CRM: STRIPE_WEBHOOK_SECRET_CUSTOMER_INVOICE_PRICE, and its regional Stripe accounts
#   STRIPE_PUBLISHABLE_KEY_<MY|AU|MX|WECHAT|UK>, STRIPE_SECRET_KEY_<MY|AU|MX|WECHAT|UK>
# - the old purchase flow's Stripe prices, which stripe:setup adopts when the account has them:
#   STRIPE_GLAMLINK_MONTHLY_PRICE_ID, STRIPE_GLAMLINK_SETUP_PRICE_ID, STRIPE_SHIPPING_PRICE_ID
# - npm run auth, which makes the first Super Admin: SUPER_ADMIN_NAME, SUPER_ADMIN_EMAIL, SUPER_ADMIN_PASSWORD
# - limits: ACCESS_TOKEN_MINUTES (15), REFRESH_TOKEN_DAYS (30), ADMIN_TOKEN_HOURS (12), DEFAULT_API_DATA_LIMIT (15),
#   UPLOAD_MAX_MB (50), STORAGE_DIR (/var/www/storage), SHIPPO_ADDRESS_VALIDATION (legacy), SHIPPO_WEBHOOK_HMAC_SECRET
